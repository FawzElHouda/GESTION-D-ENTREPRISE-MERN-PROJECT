# Port du serveur Express (Local : 5001, Render : attribué automatiquement via process.env.PORT)
PORT=5001

# Clé secrète de signature et validation des jetons JWT (Stateless)
JWT_SECRET=phrase_secrete_polytechnique_sousse_jwt_2026

# URL du client React (ex : https://votre-app.vercel.app sur Vercel)
CLIENT_URL=https://mon-app-entreprise.vercel.app

# Chaîne de connexion MongoDB Atlas (Cluster gratuit M0)
# Obtenue sur https://cloud.mongodb.com -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/gestion_entreprise?retryWrites=true&w=majority
